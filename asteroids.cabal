name:                asteroids
version:             0.1.0.0
synopsis:            Asteroids game for the Functional Programming course
category:            Game
build-type:          Simple
cabal-version:       >=1.10


executable asteroids
  main-is:             Main.hs
  build-depends:       base >= 4 && < 5,
                       gloss,
                       random
  hs-source-dirs:      src
  other-modules:       Controller
                     , Model
                     , View
                     , Movement
                     , AsteroidWaves
                     , DataTypes.Types
  default-language:    Haskell2010
  ghc-options:         -Wall
